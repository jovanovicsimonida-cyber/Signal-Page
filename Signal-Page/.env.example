# PostHog analytics — find these in PostHog → Project Settings → Project API Key
# Both variables must be set in Vercel for session recordings and event tracking to work.
# The host depends on your PostHog region:
#   EU cloud: https://eu.i.posthog.com
#   US cloud: https://us.i.posthog.com
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_token_here
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# MailerLite API key — find it in MailerLite → Integrations → API
MAILERLITE_API_KEY=your_api_key_here

# Optional: MailerLite group/segment ID to add subscribers to a specific list
# Leave blank to add to the default subscriber list
MAILERLITE_GROUP_ID=

# MailerLite group ID for leak-finder diagnostic leads (separate from Reverb leads)
# Subscribers will also have leak_reds and leak_yellows custom fields set
MAILERLITE_LEAK_FINDER_GROUP_ID=
