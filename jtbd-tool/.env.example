# LLM Provider: openai | anthropic | gemini | ollama
LLM_PROVIDER=openai

# Model name (per provider)
# OpenAI:    gpt-4o-mini (cheapest), gpt-4o (better)
# Anthropic: claude-haiku-4-5-20251001 (cheap), claude-sonnet-4-6 (balanced)
# Gemini:    gemini-2.5-flash (cheapest), gemini-2.5-pro (better)
# Ollama:    llama3:8b (free/local), mistral (free/local)
LLM_MODEL=gpt-4o-mini

# API key (leave blank for Ollama)
LLM_API_KEY=

# Ollama base URL (only needed if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434
